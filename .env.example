# --- Frontend (Vite; set in Vercel or .env.local) ---
# Convex deployment URL (printed by `npx convex dev` / `npx convex deploy`)
VITE_CONVEX_URL=

# Login required, email + password only (defaults live in .env.production)
VITE_VIKTOR_SPACES_ACCESS_MODE=authenticated
VITE_VIKTOR_SPACES_AUTH_PROVIDERS='["email_password"]'

# --- Backend (set with `npx convex env set NAME value`, not in this file) ---
# AIRTABLE_TOKEN       Airtable personal access token, data.records:read on the base
# AUTH_ALLOWED_EMAILS  Comma-separated approved emails (else any @cascadewebsolutions.co)
# RESEND_API_KEY       Optional: enables sign-up email codes and password reset
# AUTH_EMAIL_FROM      Optional: verified sender, e.g. "Work Calendar <calendar@cascadewebsolutions.co>"
# SITE_URL             The Vercel URL of the site
# JWT_PRIVATE_KEY, JWKS  Sign-in keys (generated once at setup)
