# Server settings for the Vercel functions in /api. Set them in Vercel
# (Project → Settings → Environment Variables); for `vercel dev`, pull them
# with `vercel env pull .env.local`. None of these reach the browser.

# Airtable personal access token, data.records:read on the Work Due Calendar base
AIRTABLE_TOKEN=

# Comma-separated emails allowed to sign in
AUTH_ALLOWED_EMAILS=support@cascadewebsolutions.co,info@cascadewebsolutions.co

# Random secret (32+ chars) that signs sign-in links and sessions.
# Generate: openssl rand -base64 48   (changing it signs everyone out)
AUTH_SECRET=

# Resend API key for sign-in emails
RESEND_API_KEY=

# Sender for sign-in emails; must be on a domain verified in Resend
AUTH_EMAIL_FROM="Work Due Calendar <calendar@cascadewebsolutions.co>"

# Public site address used in emailed links (defaults to the Vercel production URL)
SITE_URL=
