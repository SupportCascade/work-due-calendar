# Server settings. Set them in Vercel (Project → Settings → Environment
# Variables); for local `npm run dev`, put them in .env.local. None of these
# reach the browser.

# Accounts: comma-separated `email=hash` pairs. Make each entry with
#   npm run hash-password -- someone@cascadewebsolutions.co
AUTH_USERS=

# Random secret that signs login sessions. Generate: openssl rand -base64 32
# (changing it signs everyone out)
NEXTAUTH_SECRET=

# Site address. Vercel fills this in automatically; locally use http://localhost:3000
NEXTAUTH_URL=

# Airtable personal access token, data.records:read on the Work Due Calendar base
AIRTABLE_TOKEN=
